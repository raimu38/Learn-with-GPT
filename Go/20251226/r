#!/usr/bin/env bash
set -e

# =====================================
# Unified Utility Script (Function-based)
# =====================================

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="$ROOT_DIR/docker/docker-compose.yml"
OUTPUT_FILE="code.txt"

# -------------------------------
# Functions
# -------------------------------

docker_cmd() {
  local cmd="$1"
  case "$cmd" in
    build)
      echo "[BUILD] Building images..."
      docker compose -f "$COMPOSE_FILE" build
      ;;
    up)
      echo "[UP] Starting containers..."
      docker compose -f "$COMPOSE_FILE" up -d
      ;;
    down)
      echo "[DOWN] Stopping and removing containers..."
      docker compose -f "$COMPOSE_FILE" down
      ;;
    restart)
      echo "[RESTART] Restarting containers..."
      docker compose -f "$COMPOSE_FILE" down
      docker compose -f "$COMPOSE_FILE" up -d
      ;;
    logs)
      echo "[LOGS] Tailing container logs..."
      docker compose -f "$COMPOSE_FILE" logs -f --tail=100
      ;;
    ps)
      echo "[PS] Showing container status..."
      docker compose -f "$COMPOSE_FILE" ps
      ;;
    *)
      echo "Usage:"
      echo "  ./run {build|up|down|restart|logs|ps}"
      ;;
  esac
}

code_collect() {
  echo "[CODE] Collecting .go into $OUTPUT_FILE ..."
  > "$OUTPUT_FILE"

  find "$ROOT_DIR" -type f \( -name "*.go" -o -name "*.json" \) \
    ! -path "$ROOT_DIR/.git/*" \
    ! -path "*/notuse/*" \
  | sort \
  | while IFS= read -r FILE; do
      REL_PATH="${FILE#$ROOT_DIR/}"
      echo "===== ${REL_PATH} =====" >> "$OUTPUT_FILE"
      cat "$FILE" >> "$OUTPUT_FILE"
      echo -e "\n" >> "$OUTPUT_FILE"
    done

  echo "[DONE] Code aggregation complete: $OUTPUT_FILE"
}

# -------------------------------
# Main entrypoint
# -------------------------------
case "$1" in
  build|up|down|restart|logs|ps)
    docker_cmd "$1"
    ;;
  code)
    code_collect
    ;;
  *)
    echo "Usage:"
    echo "  ./run {build|up|down|restart|logs|ps}  # Docker操作"
    echo "  ./run code                             # Pythonコード集約"
    ;;
esac
